{
  "name": "recurso",
  "version": "1.1.6",
  "description": "Agent-to-agent orchestration for Pi.",
  "homepage": "https://github.com/neuchatech/recurso#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuchatech/recurso.git"
  },
  "bugs": {
    "url": "https://github.com/neuchatech/recurso/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "agent",
    "threads",
    "subagents",
    "orchestration",
    "recurso"
  ],
  "type": "module",
  "license": "MIT",
  "files": [
    "extensions",
    "skills",
    "docs",
    "examples",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/recurso-smoke.mjs --static",
    "check:pi": "node scripts/recurso-smoke.mjs --offline-pi",
    "check:live": "node scripts/recurso-smoke.mjs --live",
    "explore:provider-cache": "node scripts/provider-cache-probe.mjs",
    "cache:report": "node scripts/session-cache-report.mjs",
    "pack:local": "npm pack --pack-destination /tmp"
  },
  "pi": {
    "extensions": [
      "./extensions/recurso/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
