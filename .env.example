# Copy to .env or export these before running Recurso provider-cache probes.
#
# Example:
#   node scripts/provider-cache-probe.mjs --provider openrouter-deepseek --model deepseek/deepseek-v4-pro
#
# Leave keys blank until you are ready to test that provider.

# OpenRouter DS4 / DeepSeek pinned route.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_UPSTREAM_PROVIDER=deepseek

# Direct DeepSeek cache tests.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Direct OpenAI cache-lineage tests.
OPENAI_API_KEY=sk-your-openai-key-here

# Experimental: make Recurso rewrite OpenAI prompt_cache_key to a stable
# fork-lineage key so forked Pi sessions can reuse the parent prompt cache.
RECURSO_OPENAI_CACHE_LINEAGE=0

# Direct Gemini / Google AI Studio implicit-cache tests.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional Vertex AI explicit-cache tests.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional Anthropic backlog tests.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Optional Amazon Bedrock explicit-cache/backlog tests.
AWS_PROFILE=your-aws-profile
AWS_REGION=us-east-1
